server {
    listen 80;

    location / {
        # "calculator" is the Compose service name; Docker's internal DNS resolves it
        proxy_pass http://calculator:9090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}